// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role{
  PLAYER
  OWNER
}

enum Type{
  Tournament
  Training
  League
}

model User {
  id String @id @default(uuid())
  fullname String
  email String @unique
  phoneNumber Decimal @unique
  password String
  role Role @default(PLAYER)
  state String
  city String
  playerProfile PlayerProfile?
  ownerProfile  OwnerProfile?
  teams Team[] @relation("UserTeams")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
   
}

model PlayerProfile {
  id           String   @id @default(uuid())
  bio          String?
  skills       String
  battingStyle String
  bowlingStyle String
  profilePhoto String?
  achievements String[]
  stats        Json?
  teams        Team[]   @relation("PlayerTeams")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OwnerProfile {
  id           String   @id @default(uuid())
  bio          String?
  profilePhoto String?
  grounds      Ground[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String   @unique
  ownerId         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TournamentDetails {
  id String @id @default(uuid())
  title String
  description String
  tourStartsDate String
  tourEndDate String
  venue String
  entryFee String
  spots String
  type Type @default(Tournament)
  teams Team[]
  lastRegistrationDate String
   createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Team{
  id String @id @default(uuid())
  name String
  description String
  members User[] @relation("UserTeams") 
  players PlayerProfile[] @relation("PlayerTeams") 
  tournaments TournamentDetails[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ground {
  id              String   @id @default(uuid())
  name            String
  location        String
  rating          Float    @default(0.0)
  bookings        Int      @default(0)
  pitchType       String   
  facilities      String[] 
  pricePerMatch   Int      
ownerId         String
owner           OwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
createdAt       DateTime @default(now())
updatedAt       DateTime @updatedAt
}